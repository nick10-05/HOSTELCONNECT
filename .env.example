NODE_ENV=development
PORT=3000

# The app connects as a limited role that cannot drop or truncate tables.
DATABASE_URL=postgres://hostel_app:app_password_change_me@localhost:5432/hostelconnect

# Migrations use a separate, more powerful credential (never on the running server).
MIGRATION_DATABASE_URL=postgres://hostel_admin:admin_password_change_me@localhost:5432/hostelconnect

# Any long random string; generate your own for the real .env.
JWT_SECRET=replace-with-a-long-random-string
