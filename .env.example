NODE_ENV=development
PORT=3000

# The app connects as a limited role that cannot drop or truncate tables.
DATABASE_URL=postgres://hostel_app:app_password_change_me@localhost:5432/hostelconnect

# Migrations use a separate, more powerful credential (never on the running server).
MIGRATION_DATABASE_URL=postgres://hostel_admin:admin_password_change_me@localhost:5432/hostelconnect

# Any long random string; generate your own for the real .env.
JWT_SECRET=replace-with-a-long-random-string

# Optional complaint limits per student (defaults 3 and 2): active complaints at once, and new
# complaints in any 24 hours.
COMPLAINT_MAX_ACTIVE=3
COMPLAINT_MAX_NEW_PER_DAY=2

# Optional usage guard (defaults shown), set below Supabase's free limits: photo uploads
# switch off at 85% of either limit. The photo cap is in bytes (1 MB); links last 60 seconds.
STORAGE_LIMIT_MB=450
EGRESS_LIMIT_MB=3000
PHOTO_MAX_BYTES=1048576
PHOTO_LINK_SECONDS=60

# Supabase Storage for complaint photos. Left empty, photo uploads are off and complaints
# are text only. To try photos locally, use the separate Supabase development project
# (its own URL, secret key and private complaint-photos-dev bucket), never production's:
# a secret key reaches every bucket of its project (decided on day 8).
# Required in production (Render only): the server refuses to start without them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=complaint-photos-dev

# The secret header for POST /api/internal/run-jobs (at least 32 random characters).
# Required in production, where it is set in Render and in the GitHub environment
# "production". Empty locally switches the endpoint off.
JOB_SECRET=

# Optional, development only: the password every fake student from `npm run seed:students`
# gets, so you can log in as one. Leave empty if you do not need that. Never used in production.
SEED_STUDENT_PASSWORD=
